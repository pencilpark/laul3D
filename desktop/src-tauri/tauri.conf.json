{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Berria Craft",
  "version": "0.3.0",
  "identifier": "com.pencilpark.berriacraft",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Berria Craft",
        "theme": "Dark",
        "url": "index.html",
        "width": 1380,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "copyright": "Pencil Park",
    "shortDescription": "Photos vers impression 3D",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
